  void setup() {
    size (300,300);
    frameRate(30); 
  }

  void draw() {
    translate(-30,-30);
    
    //迷路を描画
    noStroke();
    for (int i = 0; i < 60; i++) {
      for (int j = 0; j < 60; j++) {
        if( maze[i][j] == 1) {
          fill(black);
        }
        else {
          fill(white);
        }
        rect(6 * j, 6 * i, 6, 6);
      }
    }
    
    stroke(0);
    
    fill(start);
    rect(30,30,30,30);
    
    fill(goal);
    rect(300,300,30,30);

    //アニメーションの終了
    if( x == 52 && y == 52) { 
      noLoop();
    }
    
    //初期値の設定
    fill(red);
    if (count == 0) {
      rect(x * 6, y * 6, 6, 6);
      direction = 0;
    }
    
    //左手の法則
    fill (red);
    
    if (count > 0) {
      switch (direction) {
        case 0: //上を向いているとき
          if (maze[y+2][x-3] == 0) { //左にブロックがなければ左を向く
            x-=5;
            direction = 3;
          } 
          else if (maze[y-3][x] == 0) { //前にブロックがなければ前に進む
            y-=v;
            
          } 
          else if (maze[y+2][x+3] == 0) { //右にブロックがなければ右に進む
            x+=5;
            direction = 1;
          }else {
            
            direction = 2;
          }
        break;
        
        case 1: //右を向いているとき
          if (maze[y-3][x-2] == 0) {
            y-=5;
            direction = 0;
          } 
          else if (maze[y][x+3] == 0) {
            x+=v;
            
          } 
          else if (maze[y+3][x-2] == 0) {
            y+=5;
            direction =2;
          }
          else {
            direction = 3;
          }
        break;
        
        case 2: //下を向いているとき
          if (maze[y-2][x+3] == 0) { 
            x+=5;
            direction = 1;
          }
          else if (maze[y+3][x] == 0) {
            y+=v;
            
          }
          else if (maze[y-2][x-3] == 0) {
            x-=5;
            direction = 3;
          }
          else {
            
            direction = 0;
          }
          
        break;
        
        case 3: //左を向いているとき
          if (maze[y+3][x+2] == 0) {
            y+=5;
            direction = 2;
          }
          else if (maze[y][x-3] == 0) {
            x-=v;
            
          }
          else if (maze[y-3][x+2] == 0) {
            y-=5;
            direction = 0;
          }
          else {
            direction = 1;
          }
          
        break;
      }
      rect(x * 6, y * 6, 6, 6);      
    }
    count++;
    println("direction=", direction);
  }
  
